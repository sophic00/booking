# Server Configuration
PORT=8080
APP_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticket_booking?sslmode=disable

# Authentication
JWT_SECRET=super-secret-jwt-key-for-ticket-booking-dev
JWT_EXPIRATION_HOURS=72

# Concurrency & Booking TTLs
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=10

# CORS
CORS_ALLOWED_ORIGINS=*

# Email Service (SMTP or Mock)
EMAIL_MOCK=true
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ticketbooking.local
