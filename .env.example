# ==============================================================================
# VelvetSeats Root Environment Template
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ticket_booking
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticket_booking?sslmode=disable

# Backend Server Configuration
PORT=8080
ENV=development
JWT_SECRET=super-secret-jwt-signing-key-32-chars-minimum
JWT_EXPIRY_HOURS=24
HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_MINUTES=15
FRONTEND_BASE_URL=http://localhost:3000

# Email Delivery (SMTP / Mock)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@velvetseats.com

# Frontend Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
